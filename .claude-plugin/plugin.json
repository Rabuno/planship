{
  "name": "planship",
  "description": "Plan (adaptive-plan-mode), ship (ship-pr), and test (user-tester) skills for Claude Code.",
  "version": "1.4.1",
  "author": {
    "name": "Rabuno",
    "url": "https://github.com/Rabuno"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File \"${CLAUDE_PLUGIN_ROOT}/hooks/adaptive-plan-mode-reminder.ps1\"",
            "shell": "powershell"
          },
          {
            "type": "command",
            "command": "powershell -File \"${CLAUDE_PLUGIN_ROOT}/hooks/advisor-trigger.ps1\"",
            "shell": "powershell"
          },
          {
            "type": "command",
            "command": "powershell -File \"${CLAUDE_PLUGIN_ROOT}/hooks/planship-mode-reminder.ps1\"",
            "shell": "powershell"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File \"${CLAUDE_PLUGIN_ROOT}/hooks/self-improve-stop.ps1\"",
            "shell": "powershell"
          }
        ]
      }
    ]
  }
}
